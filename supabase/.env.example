# Edge Function secrets — PLACEHOLDERS ONLY. Real values are set with `supabase secrets set …` (cloud) or
# generated into the gitignored supabase/.env.local by `node scripts/mock-razorpay.mjs --write-env` (local).
# Never commit real keys. SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are injected by the platform: do not set them.
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME_RANDOM_32_CHARS
# test | live — must agree with the key prefix (rzp_test_ / rzp_live_) or the payment functions refuse to work
APP_GATEWAY_MODE=test
# local only: the mock gateway (Colima: host.lima.internal, else host.docker.internal). Leave unset in the cloud.
# RAZORPAY_API_BASE=http://host.lima.internal:54399
CRON_SECRET=REPLACE_ME_RANDOM_32_CHARS
VAPID_PUBLIC_KEY=REPLACE_ME
VAPID_PRIVATE_KEY=REPLACE_ME
VAPID_SUBJECT=mailto:office@example.com
